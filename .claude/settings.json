{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(coderabbit review:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/branch-reminder.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/bash_edit_guard.py\""
          }
        ]
      }
    ]
  }
}
